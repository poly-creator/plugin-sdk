{
	"name": "@polycreator/plugin-sdk",
	"version": "0.3.3",
	"description": "Plugin SDK for PolyCreator — types + PolycreatorPlugin base class for building third-party renderer plugins (toolbar, agents, canvas events, providers).",
	"keywords": [
		"agents",
		"canvas",
		"plugin",
		"polycreator",
		"sdk"
	],
	"homepage": "https://github.com/poly-creator/plugin-sdk#readme",
	"bugs": {
		"url": "https://github.com/poly-creator/plugin-sdk/issues"
	},
	"license": "MIT",
	"author": "PolyCreator",
	"repository": {
		"type": "git",
		"url": "https://github.com/poly-creator/plugin-sdk.git"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./host": {
			"types": "./dist/host.d.ts",
			"default": "./dist/host.js"
		},
		"./base": {
			"types": "./dist/base.d.ts",
			"default": "./dist/base.js"
		},
		"./component": {
			"types": "./dist/component.d.ts",
			"default": "./dist/component.js"
		},
		"./settings": {
			"types": "./dist/settings.d.ts",
			"default": "./dist/settings.js"
		},
		"./modal": {
			"types": "./dist/modal.d.ts",
			"default": "./dist/modal.js"
		},
		"./menu": {
			"types": "./dist/menu.d.ts",
			"default": "./dist/menu.js"
		},
		"./ai": {
			"types": "./dist/ai.d.ts",
			"default": "./dist/ai.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/rewrite-dts-imports.mjs dist",
		"clean": "rm -rf dist",
		"check": "tsc -p tsconfig.json --noEmit",
		"prepublishOnly": "pnpm clean && pnpm build",
		"test": "vitest run"
	},
	"peerDependencies": {
		"lucide-react": ">=0.400.0"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"jsdom": "^26.1.0"
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
